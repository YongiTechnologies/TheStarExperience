# Copy to .env.local for local development. NEXT_PUBLIC_* values are baked in at
# build time, so rebuild after changing them (the Docker image takes
# NEXT_PUBLIC_API_URL as a build arg). Never commit the real .env.local.

# The backend's base URL. The backend must list this site's origin in CORS_ORIGINS
# (its default allows http://localhost:3000). Unset, the app uses the hosted backend on Render.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: the address staff phones open, used in device setup links and QR codes.
# Set it when admins use an address phones can't reach (e.g. localhost). Unset, it's
# the address the admin page is open on.
NEXT_PUBLIC_SITE_URL=
